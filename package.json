{
  "name": "qubix-university",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-pilot.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-chapters.mjs && node scripts/check-exercises.mjs && node scripts/check-missions.mjs && node scripts/check-rehearsals.mjs && node scripts/check-rates.mjs && node scripts/check-palette.mjs && node scripts/check-store-map.mjs && node scripts/check-figures.mjs && node scripts/check-workshops.mjs && node scripts/check-assistant.mjs && node scripts/check-scroll.mjs && node scripts/check-timing.mjs && node scripts/check-type.mjs && node scripts/check-world.mjs && node scripts/check-assets.mjs && node scripts/build-book.mjs && node scripts/build-spine.mjs && node scripts/publish-library.mjs && node scripts/build-seo.mjs && node scripts/build-pilot.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "app:install": "npm --prefix current-app ci",
    "app:dev": "npm --prefix current-app run dev",
    "app:build": "npm --prefix current-app run build",
    "app:test": "npm --prefix current-app run test:security",
    "deploy": "node scripts/deploy.mjs",
    "build:book": "node scripts/build-book.mjs",
    "check:book": "node scripts/check-book-maths.mjs",
    "build:spine": "node scripts/build-spine.mjs",
    "build:library": "npm run build:book && npm run build:spine && node scripts/publish-library.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "state": "node scripts/build-state.mjs",
    "check:missions": "node scripts/check-missions.mjs",
    "check:chapters": "node scripts/check-chapters.mjs",
    "check:exercises": "node scripts/check-exercises.mjs",
    "check:rehearsals": "node scripts/check-rehearsals.mjs",
    "check:rates": "node scripts/check-rates.mjs",
    "check:palette": "node scripts/check-palette.mjs",
    "check:map": "node scripts/check-store-map.mjs",
    "check:figures": "node scripts/check-figures.mjs",
    "check:workshops": "node scripts/check-workshops.mjs",
    "check:assistant": "node scripts/check-assistant.mjs",
    "check:scroll": "node scripts/check-scroll.mjs",
    "check:timing": "node scripts/check-timing.mjs",
    "build:seo": "node scripts/build-seo.mjs",
    "estimate:time": "node scripts/estimate-time.mjs",
    "check:type": "node scripts/check-type.mjs",
    "check:world": "node scripts/check-world.mjs",
    "data": "node scripts/generate-dataset.mjs",
    "check:dataset": "node scripts/check-dataset.mjs",
    "data:sample": "node scripts/generate-dataset.mjs --start-day 30 --days 7 --branches 6 --out data-sample",
    "data:pack": "node scripts/pack-data.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge": "^1.3.1",
    "pixi.js": "^8.19.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "nodemailer": "^9.0.3",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "svelte": "^4.2.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20.10"
  }
}
