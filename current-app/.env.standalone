# Safe, credential-free defaults for bundled local lessons.
VITE_APP_ENV=standalone
VITE_PUBLIC_SITE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://standalone.invalid
VITE_SUPABASE_ANON_KEY=standalone-anon-key
VITE_ENABLE_TEST_TOOLS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SERVICE_WORKER=false
VITE_ENABLE_PHONE_AUTH=false
